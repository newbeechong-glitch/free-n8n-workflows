          "mode": "list",
          "value": ""
        },
        "text": "=:fire: HOT lead: {{ $json.name }} ({{ $json.company }}) - score {{ $json.score }}. Email: {{ $json.email }} Phone: {{ $json.phone }}",
        "otherOptions": {}
      },
      "id": "86df2c19-81c7-4861-a47a-08115dafe2a6",
